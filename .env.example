# HTTP
PORT=3000

# SQL Server (base de dados UNUM) - usado pelo TypeORM
DB_HOST=
DB_PORT=1433
DB_INSTANCE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Ligacao RFC a SAP (node-rfc)
SAP_ASHOST=
SAP_SYSNR=
SAP_CLIENT=
SAP_USER=
SAP_PASSWORD=
SAP_LANG=PT

# Contexto da aplicacao chamadora (equivalente a IdAplicacao/NomeAplicacao/PerfilBD do WorkArea legado)
APP_ID=
APP_NAME=UNUM_API
APP_PROFILE=
APP_DEFAULT_LANG=PT
